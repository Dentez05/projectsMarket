# Шаблон секретов. Скопируй в .env и заполни своими значениями.
#   cp .env.example .env
# Файл .env в .gitignore и в git НЕ попадает.

# Общее окружение: Development (локально) | Production (сервер)
ENVIRONMENT=Production
# Публичный адрес сайта (для ReturnUrl платежей)
PUBLIC_URL=https://example.com

# Postgres
POSTGRES_PASSWORD=change-me-long-random

# JWT: минимум 32 символа, сгенерируй свой, например:
#   openssl rand -base64 48
JWT_KEY=change-me-min-32-chars-random

# Администратор создаётся при первом запуске (если в БД нет ни одного admin).
# Пароль: минимум 12 символов. После создания в БД пароль НЕ перезаписывается.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars

# YooKassa — возьми в личном кабинете. Тестовый ключ НЕ использовать в проде.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional: логин/пароль Basic-аутентификации для вебхука YooKassa
# (задаются в настройках уведомления: https://login:password@url)
YOOKASSA_WEBHOOK_USER=
YOOKASSA_WEBHOOK_PASSWORD=

# Фронтенд порт (на сервере обычно 80 или 443 за nginx)
FRONTEND_PORT=80
